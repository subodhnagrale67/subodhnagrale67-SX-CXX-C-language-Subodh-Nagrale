#include <stdio.h>

int main() {
    int x = 10;
    int y = 12;
    printf("x=%d,y=%d \n",x,y);
    
    printf("is x equal to y?   (x == y):- %d\n    ",x==y);
    printf("is x not equal to y?  (x!=y):- %d\n",x!=y);
    printf("is x greater than y? (x>y):- %d\n",x>y);
    printf("is x smaller than y? (x<y):- %d\n",x<y);
    printf("is x greater than equals to y? (x>=y):- %d \n",x>=y);
    printf("is x smaller than equals to y? (x<=y):- %d \n",x<=y);
    
    return 0;
}
